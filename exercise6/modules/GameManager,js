// Singleton Game Manager
class GameManager {
    static instance = null;
    
    constructor() {
        if (GameManager.instance) {
            return GameManager.instance;
        }
        
        this.gravity = 900;
        this.shapeFrequency = 1; // shapes per second
        this.shapes = [];
        this.isRunning = true;
        this.totalArea = 0;
        
        GameManager.instance = this;
        return this;
    }
    
    static getInstance() {
        if (!GameManager.instance) {
            GameManager.instance = new GameManager();
        }
        return GameManager.instance;
    }
    
    setGravity(value) {
        this.gravity = Math.max(100, Math.min(2000, value));
    }
    
    setShapeFrequency(value) {
        this.shapeFrequency = Math.max(0.1, Math.min(10, value));
    }
    
    addShape(shape) {
        this.shapes.push(shape);
    }
    
    removeShape(shape) {
        const index = this.shapes.indexOf(shape);
        if (index > -1) {
            this.shapes.splice(index, 1);
        }
    }
    
    clearShapes() {
        this.shapes = [];
    }
    
    calculateTotalArea() {
        this.totalArea = this.shapes.reduce((sum, shape) => sum + shape.area, 0);
        return this.totalArea;
    }
}

export { GameManager };